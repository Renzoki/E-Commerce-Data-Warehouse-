digraph star_schema {
  graph [rankdir=LR, splines=spline, nodesep=0.6, ranksep=1.5, fontname="Helvetica"];
  node [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=11, arrowsize=1.2, labeldistance=1.8, dir=both];
  dim_customer [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#9DC3E6"><B>dim_customer</B></TD></TR><TR><TD ALIGN="LEFT" PORT="customer_key"><U>customer_key</U></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD><TD PORT="customer_key_r"><B>PK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD><TD PORT="user_id_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="username">username</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255)</FONT></TD><TD PORT="username_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="full_name">full_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255)</FONT></TD><TD PORT="full_name_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="gender">gender</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">char(1)</FONT></TD><TD PORT="gender_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="birth_date">birth_date</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">date</FONT></TD><TD PORT="birth_date_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="age_group">age_group</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(10)</FONT></TD><TD PORT="age_group_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="city">city</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255)</FONT></TD><TD PORT="city_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="country">country</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255)</FONT></TD><TD PORT="country_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="zip_code">zip_code</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">char(5)</FONT></TD><TD PORT="zip_code_r"> </TD></TR></TABLE>>];
  dim_date [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#9DC3E6"><B>dim_date</B></TD></TR><TR><TD ALIGN="LEFT" PORT="date_key"><U>date_key</U></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD><TD PORT="date_key_r"><B>PK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="full_date">full_date</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">date</FONT></TD><TD PORT="full_date_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="day">day</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">tinyint</FONT></TD><TD PORT="day_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="day_name">day_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(9)</FONT></TD><TD PORT="day_name_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="month">month</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">tinyint</FONT></TD><TD PORT="month_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="month_name">month_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(9)</FONT></TD><TD PORT="month_name_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="quarter">quarter</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">tinyint</FONT></TD><TD PORT="quarter_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="year">year</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">smallint</FONT></TD><TD PORT="year_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="is_weekend">is_weekend</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">tinyint</FONT></TD><TD PORT="is_weekend_r"> </TD></TR></TABLE>>];
  dim_product [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#9DC3E6"><B>dim_product</B></TD></TR><TR><TD ALIGN="LEFT" PORT="product_key"><U>product_key</U></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD><TD PORT="product_key_r"><B>PK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="product_id">product_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD><TD PORT="product_id_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="product_code">product_code</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255)</FONT></TD><TD PORT="product_code_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="product_name">product_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255)</FONT></TD><TD PORT="product_name_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="category">category</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(50)</FONT></TD><TD PORT="category_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="unit_price">unit_price</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">decimal(10, 2)</FONT></TD><TD PORT="unit_price_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="price_range">price_range</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(20)</FONT></TD><TD PORT="price_range_r"> </TD></TR></TABLE>>];
  dim_rider [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#9DC3E6"><B>dim_rider</B></TD></TR><TR><TD ALIGN="LEFT" PORT="rider_key"><U>rider_key</U></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD><TD PORT="rider_key_r"><B>PK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="rider_id">rider_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD><TD PORT="rider_id_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="full_name">full_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255)</FONT></TD><TD PORT="full_name_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="gender">gender</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">char(1)</FONT></TD><TD PORT="gender_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="age">age</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">tinyint</FONT></TD><TD PORT="age_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="age_group">age_group</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(10)</FONT></TD><TD PORT="age_group_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="vehicle_type">vehicle_type</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(20)</FONT></TD><TD PORT="vehicle_type_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="courier_name">courier_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255)</FONT></TD><TD PORT="courier_name_r"> </TD></TR></TABLE>>];
  fact_sales [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#F4B183"><B>fact_sales</B></TD></TR><TR><TD ALIGN="LEFT" PORT="sales_id"><U>sales_id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD><TD PORT="sales_id_r"><B>PK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="date_key">date_key</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD><TD PORT="date_key_r"><B>FK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="customer_key">customer_key</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD><TD PORT="customer_key_r"><B>FK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="product_key">product_key</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD><TD PORT="product_key_r"><B>FK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="rider_key">rider_key</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD><TD PORT="rider_key_r"><B>FK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="order_id">order_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD><TD PORT="order_id_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="order_number">order_number</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255)</FONT></TD><TD PORT="order_number_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="quantity">quantity</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">integer</FONT></TD><TD PORT="quantity_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="unit_price">unit_price</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">decimal(10, 2)</FONT></TD><TD PORT="unit_price_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="line_amount">line_amount</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">decimal(12, 2)</FONT></TD><TD PORT="line_amount_r"> </TD></TR></TABLE>>];
  dim_customer:customer_key_r:e -> fact_sales:customer_key:w [arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="N"];
  dim_date:date_key_r:e -> fact_sales:date_key:w [arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="N"];
  fact_sales:product_key_r:e -> dim_product:product_key:w [arrowtail=crow, arrowhead=tee, taillabel="N", headlabel="1"];
  fact_sales:rider_key_r:e -> dim_rider:rider_key:w [arrowtail=crow, arrowhead=tee, taillabel="N", headlabel="1"];
}